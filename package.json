{
  "name": "2002",
  "publisher": "codesketcher",
  "displayName": "ChatVS",
  "description": "A program to help code via llm",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension",
  "contributes": {
    "configuration": {
      "title": "AiProgram",
      "properties": {
        "ai.projectPath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "指定项目的根路径，将在此路径下创建 codes 和 pseudocodes 文件夹。例如: D:\\myproject"
        },
        "ai.language": {
          "type": "string",
          "default": "java",
          "enum": [
            "java",
            "python",
            "c++",
            "c",
            "javascript",
            "typescript",
            "html"
          ],
          "markdownDescription": "Programming language used in the generated code"
        },
        "codeRefinement.azureOpenAI.apiKey": {
          "type": "string",
          "description": "Azure OpenAI API Key",
          "markdownDescription": "你的 [Azure OpenAI API Key](https://platform.openai.com/api-keys)"
        },
        "codeRefinement.azureOpenAI.endpoint": {
          "type": "string",
          "description": "Azure OpenAI 端点",
          "markdownDescription": "你的 Azure OpenAI 端点地址，格式如: `https://xxx.openai.azure.com/`"
        }
      }
    },
    "commands": [
      {
        "command": "CodeToolBox.openChatGPTView",
        "title": "打开chatGPT对话框"
      },
      {
        "command": "CodeToolBox.openSettings",
        "title": "打开设置"
      },
      {
        "command": "CodeToolBox.switchDisplay",
        "title": "Switch Display Style"
      },
      {
        "command": "CodeToolBox.confirmLine",
        "title": "Confirm Line"
      },
      {
        "command": "refinement.globalRefine",
        "title": "全局精化"
      },
      {
        "command": "refinement.localRefine",
        "title": "局部精化"
      },
      {
        "command": "refinement.generateCode",
        "title": "生成代码"
      },
      {
        "command": "refinement.rollback",
        "title": "回退粒度"
      },
      {
        "command": "CodeToolBox.createModule",
        "title": "创建子模块",
        "icon": "images/add-module.svg",
        "enablement": "CodeToolBox.enableCreateModule"
      },
      {
        "command": "CodeToolBox.createProj",
        "title": "创建项目",
        "icon": "images/add-proj.svg"
      },
      {
        "command": "CodeToolBox.deleteModule",
        "title": "删除节点",
        "enablement": "!(viewItem =~ /fixed/)"
      },
      {
        "command": "CodeToolBox.deleteProject",
        "title": "删除项目"
      },
      {
        "command": "CodeToolBox.divideModule",
        "title": "划分子模块",
        "enablement": "viewItem =~ /leaf/ && !(viewItem =~ /fixed/)"
      },
      {
        "command": "CodeToolBox.firstDivision",
        "title": "初始模块划分",
        "enablement": "viewItem =~ /empty/"
      },
      {
        "command": "CodeToolBox.extractCommonDataStructure",
        "title": "提取通用数据结构",
        "enablement": "viewItem =~ /dataStructureExtractable/"
      },
      {
        "command": "CodeToolBox.getLeafModules",
        "title": "结束设计阶段",
        "enablement": "viewItem =~ /designmentCompletable/"
      }
    ],
    "keybindings": [
      {
        "key": "alt+c",
        "command": "CodeToolBox.confirmLine",
        "when": "editorTextFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "CodeToolBox",
          "title": "CodeSketcher",
          "icon": "images/tool.png",
          "initialWidth": 10000
        }
      ],
      "panel": [
        {
          "id": "RefinementContainer",
          "title": "精化面板",
          "icon": "$(layout-panel-right)"
        }
      ]
    },
    "views": {
      "CodeToolBox": [
        {
          "id": "CodeToolBox.welcome",
          "name": "welcome",
          "when": "!CodeToolBox.chatGPTView"
        },
        {
          "id": "CodeToolBox.chatGPTView",
          "name": "CodeSketcher",
          "when": "CodeToolBox.chatGPTView"
        }
      ],
      "RefinementContainer": [
        {
          "type": "webview",
          "id": "OperationPanelView",
          "name": "Operation panel",
          "visibility": "visible"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "CodeToolBox.welcome",
        "contents": "[打开CodeSketcher对话框](command:CodeToolBox.openChatGPTView)\n[设置](command:CodeToolBox.openSettings)"
      }
    ],
    "submenus": [
      {
        "id": "CodeToolBox.toolsMenu",
        "label": "🤖 CodeSketcher"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "group": "navigation",
          "submenu": "CodeToolBox.toolsMenu"
        }
      ],
      "editor/title": [
        {
          "command": "CodeToolBox.switchDisplay",
          "when": "resourceExtname == .java",
          "group": "navigation"
        }
      ],
      "CodeToolBox.toolsMenu": [],
      "view/title": [
        {
          "command": "CodeToolBox.createModule",
          "when": "view == CodeToolBox.chatGPTView",
          "group": "navigation"
        },
        {
          "command": "CodeToolBox.createProj",
          "when": "view == CodeToolBox.chatGPTView",
          "group": "navigation"
        }
      ],
      "comments/commentThread/context": [],
      "view/item/context": [
        {
          "command": "CodeToolBox.deleteModule",
          "when": "view == CodeToolBox.chatGPTView && !(viewItem =~ /banned/) && viewItem =~ /module/",
          "group": "2_human_design@1"
        },
        {
          "command": "CodeToolBox.deleteProject",
          "when": "view == CodeToolBox.chatGPTView && !(viewItem =~ /banned/) && viewItem =~ /project/",
          "group": "2_human_design@2"
        },
        {
          "command": "CodeToolBox.extractCommonDataStructure",
          "when": "view == CodeToolBox.chatGPTView && !(viewItem =~ /banned/) && viewItem =~ /project/",
          "group": "1_ai_design@2"
        },
        {
          "command": "CodeToolBox.firstDivision",
          "when": "view == CodeToolBox.chatGPTView && !(viewItem =~ /banned/) && viewItem =~ /project/",
          "group": "1_ai_design@1"
        },
        {
          "command": "CodeToolBox.divideModule",
          "when": "view == CodeToolBox.chatGPTView && !(viewItem =~ /banned/) && viewItem =~ /module/",
          "group": "1_ai_design@4"
        },
        {
          "command": "CodeToolBox.getLeafModules",
          "when": "view == CodeToolBox.chatGPTView && !(viewItem =~ /banned/) && viewItem =~ /project/",
          "group": "1_ai_design@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/fs-extra": "^11.0.4",
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "@types/vscode": "^1.91.0",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.11.0",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0",
    "eslint": "^8.57.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@dqbd/tiktoken": "^1.0.22",
    "@azure/identity": "^4.4.1",
    "@azure/openai": "^2.0.0-beta.2",
    "azure-openai": "^0.9.4",
    "diff": "^8.0.2",
    "dotenv": "^16.4.5",
    "font-awesome": "^4.7.0",
    "fs-extra": "^11.2.0",
    "json5": "^2.2.3",
    "openai": "^4.61.0",
    "react": "^18.3.1",
    "vsce": "^2.15.0",
    "vscode-webview-tool": "^1.0.4",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yarn": "^1.22.22",
    "zod": "^3.25.76"
  }
}
